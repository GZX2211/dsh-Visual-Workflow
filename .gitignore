# 依赖与构建产物

# 依赖
node_modules/
.pnpm-store/

# 构建产物（lib 已提交作为分发包：源码改动后需重新 pnpm build 并同步提交 lib，与源码保持一致）。
# 根级锚定：src/client/lib/ 是源码目录，不得忽略。
# lib/ 现为可提交分发包，不再忽略；仅调试源码映射（*.map）不入库，运行时无需。
lib/**/*.map

# TypeScript 增量产物
*.tsbuildinfo

# 测试产物
coverage/
imgs/

# 临时验证目录（T-002 Loader 验证：临时 DSH_HOME / scratch profile，避免污染用户全局环境）
.tmp/

# 编辑器 / 系统临时
.DS_Store
Thumbs.db
*.log

# 本地浏览器 E2E 临时目录
.edge-tmp/

# AI 提示词工程文件
prompt/

# CodeGraph 本地索引（codegraph init 生成，不提交）
.codegraph/
codegraph.json

# docs
bug/