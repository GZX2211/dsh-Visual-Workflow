{
  // Host 半区 program（Node.js 运行面）：src/host + src/host/shared。
  // 与 tsconfig.client.json 完全隔离（SKILL.md §6.1）：各自独立 includes，
  // 避免 host session 与 browser runtime 对同名 Context service 的
  // declaration merge 冲突。构建产物形态见 scripts/build.mjs（方案 B：
  // tsc 发射 JS 到 lib/，声明单独发射到 lib/types/）。
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src/host",
    "outDir": "lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    // 内置模板种子以 JSON 随包分发（builtin-templates/flow-design-guide.json）：
    // 需要 JSON 模块解析；被 import 的 JSON 会作为输入文件随 tsc 发射到 lib/。
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["src/host/**/*.ts"],
  "exclude": ["node_modules", "lib", "src/client", "tests", "scripts"]
}
